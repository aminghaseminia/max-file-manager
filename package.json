{
  "name": "max-file-manager",
  "version": "0.12.0",
  "description": "Dual-pane file manager for KDE and Windows (Directory Opus class), Electron + TypeScript",
  "license": "MIT",
  "author": "Majid Asgari <majidasgari@users.noreply.github.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test src/main/*.test.ts src/renderer/src/*.test.ts",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vazirmatn": "^33.0.3",
    "vite": "^7.0.0"
  }
}
